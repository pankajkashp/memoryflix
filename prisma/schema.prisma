generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum StoryStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories Story[]
  media   MediaAsset[]
}

model StoryTemplate {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  previewImageUrl String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  stories Story[]
}

model Story {
  id          String      @id @default(cuid())
  userId      String
  templateId   String
  title        String
  description  String?
  occasion     String?
  eventDate    DateTime?
  slug         String?     @unique
  status       StoryStatus @default(DRAFT)
  publishedAt  DateTime?
  coverMediaId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   StoryTemplate @relation(fields: [templateId], references: [id])
  media      MediaAsset[]  @relation("StoryMedia")
  coverMedia MediaAsset?   @relation("StoryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
}

model MediaAsset {
  id              String    @id @default(cuid())
  storyId         String
  userId          String
  type            MediaType
  url             String
  storageKey      String
  caption         String?
  position        Int       @default(0)
  durationSeconds Int?
  sizeBytes       Int?
  createdAt       DateTime  @default(now())

  story Story @relation("StoryMedia", fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  storyCover Story[] @relation("StoryCover")
}