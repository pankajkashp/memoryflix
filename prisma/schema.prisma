generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum StoryStatus {
  DRAFT
  COMPLETED
  PAID
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PaymentStatus {
  UNPAID
  PAID
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media    MediaAsset[]
  payments Payment[]
}

model Template {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  price       Int      // in paise
  description String
  previewUrl  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  pages   TemplatePageBlueprint[]
  stories Story[]
}

model TemplatePageBlueprint {
  id             String @id @default(cuid())
  templateId     String
  position       Int
  componentKey   String   // "NOTIFICATION" | "DEFINITION" | "LOADING" | "CERTIFICATE" | "LABELED_PHOTO" | "SEARCH" | "LETTER"
  fixedConfig    Json     // locked bg/colors/positions/fonts for this page
  editableSchema Json     // declares which fields are user-editable on this page

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@unique([templateId, position])
}

model Story {
  id                 String        @id @default(cuid())
  email              String?
  templateId         String
  status             StoryStatus   @default(DRAFT)
  paymentStatus      PaymentStatus @default(UNPAID)
  slug               String?       @unique
  editToken          String        @unique
  editTokenExpiresAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  template      Template            @relation(fields: [templateId], references: [id])
  pageInstances StoryPageInstance[]
  payments      Payment[]
  media         MediaAsset[]

  @@index([email])
  @@index([templateId])
}

model StoryPageInstance {
  id                      String   @id @default(cuid())
  storyId                 String
  templatePageBlueprintId String
  fieldValues             Json
  mediaId                 String?
  updatedAt               DateTime @updatedAt

  story Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([storyId])
}

model MediaAsset {
  id              String    @id @default(cuid())
  storyId         String
  userId          String?
  type            MediaType
  url             String
  storageKey      String
  caption         String?
  title           String?
  memoryNote      String?
  location        String?
  memoryDate      DateTime?
  position        Int       @default(0)
  durationSeconds Int?
  sizeBytes       Int?
  createdAt       DateTime  @default(now())

  story         Story               @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id])
  pageInstances StoryPageInstance[]

  @@index([storyId])
  @@index([userId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String?
  storyId           String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  amount            Int      // in paise (e.g., 4900 = ₹49)
  currency          String   @default("INR")
  status            String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storyId])
}